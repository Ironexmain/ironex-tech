  var d=document;
  d.documentElement.classList.add('js');
  function show(el){el.setAttribute('data-shown','');}
  function init(){
    var els=d.querySelectorAll('[data-reveal]');
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    if(reduce||!('IntersectionObserver' in window)){els.forEach(show);return;}
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){show(e.target);io.unobserve(e.target);}});
    },{threshold:0.15,rootMargin:'0px 0px -60px 0px'});
    function observe(el){if(!el.hasAttribute('data-shown'))io.observe(el);}
    els.forEach(observe);
    if(d.body){
      new MutationObserver(function(muts){
        muts.forEach(function(m){
          m.addedNodes&&m.addedNodes.forEach(function(n){
            if(n.nodeType!==1)return;
            if(n.matches&&n.matches('[data-reveal]'))observe(n);
            n.querySelectorAll&&n.querySelectorAll('[data-reveal]').forEach(observe);
          });
        });
      }).observe(d.body,{childList:true,subtree:true});
    }
    setTimeout(function(){
      if(!d.querySelector('[data-reveal][data-shown]')&&d.querySelector('[data-reveal]'))
        d.querySelectorAll('[data-reveal]').forEach(show);
    },1500);
  }
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',init);
  else init();
})();</script><script>(function(){
  var d=document;
  function fmt(v,dec){return dec?v.toFixed(dec).replace('.',','):Math.round(v).toLocaleString('ru-RU');}
  function finalText(el){
    var end=parseFloat(el.getAttribute('data-count')||'0');
    var dec=parseInt(el.getAttribute('data-decimals')||'0',10);
    return fmt(end,dec);
  }
  function setFinal(el){if(el.getAttribute('data-counted')==='done')return;el.setAttribute('data-counted','done');el.textContent=finalText(el);}
  function animate(el){
    if(el.getAttribute('data-counted'))return;
    el.setAttribute('data-counted','run');
    var end=parseFloat(el.getAttribute('data-count')||'0');
    var dec=parseInt(el.getAttribute('data-decimals')||'0',10);
    var dur=1400,start=null;
    function tick(now){
      if(start===null)start=now;
      var t=Math.min(1,(now-start)/dur);
      var eased=1-Math.pow(1-t,3);
      el.textContent=fmt(end*eased,dec);
      if(t<1)requestAnimationFrame(tick);
      else{el.textContent=finalText(el);el.setAttribute('data-counted','done');}
    }
    requestAnimationFrame(tick);
  }
  function init(){
    var els=d.querySelectorAll('[data-count]');
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    if(reduce||!('IntersectionObserver' in window)){els.forEach(setFinal);return;}
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){if(e.isIntersecting){animate(e.target);io.unobserve(e.target);}});
    },{threshold:0.25});
    function observe(el){if(!el.getAttribute('data-counted'))io.observe(el);}
    els.forEach(observe);
    if(d.body){
      new MutationObserver(function(muts){
        muts.forEach(function(m){
          m.addedNodes&&m.addedNodes.forEach(function(n){
            if(n.nodeType!==1)return;
            if(n.matches&&n.matches('[data-count]'))observe(n);
            n.querySelectorAll&&n.querySelectorAll('[data-count]').forEach(observe);
          });
        });
      }).observe(d.body,{childList:true,subtree:true});
    }
    setTimeout(function(){
      d.querySelectorAll('[data-count]:not([data-counted])').forEach(function(el){
        var r=el.getBoundingClientRect();
        if(r.top<window.innerHeight&&r.bottom>0)animate(el);
      });
    },2500);
  }
  if(d.readyState==='loading')d.addEventListener('DOMContentLoaded',init);
  else init();
})();</script><header class="header" data-header="true"><div class="container header__inner"><a class="logo" href="/"><span class="logo__mark">IX</span>IRONEX</a><nav class="nav" data-nav="true"><div class="nav__mega"><a class="has-menu" href="/uslugi">Услуги</a><div class="megamenu"><div class="megamenu__inner"><div class="megamenu__col"><div class="megamenu__col-title">Механообработка ЧПУ</div><ul><li><a href="/uslugi/tokarnaya-obrabotka">Токарная обработка</a></li><li><a href="/uslugi/chistovaya-tokarnaya-obrabotka">Чистовая токарная обработка</a></li><li><a href="/uslugi/chernovaya-tokarnaya-obrabotka">Черновая токарная обработка</a></li><li><a href="/uslugi/frezernaya-obrabotka">Фрезерная обработка</a></li><li><a href="/uslugi/tokarno-frezernaya-obrabotka-chpu">Токарно-фрезерная ЧПУ</a></li><li><a href="/uslugi/sverlenie-rastochka">Сверление и расточка</a></li><li><a href="/uslugi/shlifovka">Шлифовка</a></li></ul></div><div class="megamenu__col"><div class="megamenu__col-title">Резка и листовая обработка</div><ul><li><a href="/uslugi/lazernaya-rezka">Лазерная резка</a></li><li><a href="/uslugi/gidroabrazivnaya-rezka">Гидроабразивная резка</a></li><li><a href="/uslugi/plazmennaya-rezka">Плазменная резка</a></li><li><a href="/uslugi/gibka-listovogo-metalla">Гибка листового металла</a></li><li><a href="/uslugi/perforaciya">Координатно-пробивные работы</a></li><li><a href="/uslugi/shtampovka">Штамповка</a></li></ul></div><div class="megamenu__col"><div class="megamenu__col-title">Сварка · финиш · контроль</div><ul><li><a href="/uslugi/svarochnye-raboty">Сварочные работы</a></li><li><a href="/uslugi/poroshkovaya-pokraska">Порошковая окраска</a></li><li><a href="/uslugi/galvanika-pokrytiya">Гальваника и покрытия</a></li><li><a href="/uslugi/lazernaya-markirovka">Лазерная маркировка</a></li><li><a href="/uslugi/snyatie-faski">Снятие фаски</a></li><li><a href="/uslugi/slesarnye-raboty">Слесарные работы</a></li><li><a href="/uslugi/kim-kontrol">КИМ-контроль</a></li></ul